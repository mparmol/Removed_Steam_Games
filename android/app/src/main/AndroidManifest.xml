<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Desde Android 13 el usuario tiene que conceder las notificaciones a mano -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Permite que los avisos urgentes atraviesen el modo No molestar. Android solo
         lo concede si el usuario lo autoriza expresamente en los ajustes. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RemovedSteamGames">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.RemovedSteamGames">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="Iniciar sesión en Steam"
            android:theme="@style/Theme.RemovedSteamGames" />

        <service
            android:name=".notif.MensajeriaService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="resumen_v2" />

    </application>
</manifest>
